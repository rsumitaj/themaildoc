.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Logs and local scratch
*.log
npm-debug.log*
pnpm-debug.log*
coverage/
.tmp/

# Internal product and strategy notes. Deliberately out of the repo: the code
# is the deliverable, the business material is not.
/context/
/CLAUDE.md
