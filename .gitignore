*.tsbuildinfo

# Generated from wrangler.jsonc by `wrangler types`. 550KB of runtime
# declarations that change with every workerd release, so it is regenerated
# rather than committed. `pnpm typecheck` runs it first.
apps/web/worker-configuration.d.ts

# Secrets and local config. Nothing in here is ever committed.
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example

