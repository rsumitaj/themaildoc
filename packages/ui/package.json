{
  "name": "@maildoc/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./EkgBackground.astro": "./src/EkgBackground.astro",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
