{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maildoc",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // The Astro adapter generates `main` and `assets` itself — prerendered pages
  // are served as free static assets, and only /api/* invokes the Worker.
  //
  // The only stored data in the product: consultation requests from /practice.
  // Everything else reads public DNS and forgets. Create and migrate with:
  //
  //   wrangler d1 create maildoc-leads          (paste the id below)
  //   wrangler d1 execute maildoc-leads --remote --file=migrations/0001_create_leads.sql
  //
  // `wrangler dev` ignores the id and uses a local SQLite file, so the form
  // works offline without touching the real database.
  "d1_databases": [
    {
      "binding": "LEADS",
      "database_name": "maildoc-leads",
      "database_id": "PLACEHOLDER_RUN_WRANGLER_D1_CREATE"
    }
  ]

  // Phase 2, once created with `wrangler r2 bucket create maildoc-geo`:
  //
  // "r2_buckets": [
  //   { "binding": "GEO", "bucket_name": "maildoc-geo" }
  // ]
}
