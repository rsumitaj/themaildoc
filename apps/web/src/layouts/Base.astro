---
import '@maildoc/ui/maildoc.css';
import { BRAND_RED } from '@maildoc/ui';
import ClinicStatusBar from '../components/ClinicStatusBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Seo from '../components/Seo.astro';
import type { Props as SeoProps } from '../components/Seo.astro';

/**
 * Every page's shell. All SEO lives in `Seo.astro`, which this passes straight
 * through, so there is exactly one definition of a canonical, a card and a
 * schema block.
 */
type Props = SeoProps;

const seo = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...seo} />

    <!--
      Three icons, and the middle one is the one Google reads.

      The search result showed a generic globe rather than the mark, and both
      reasons were here. Google will only consider a favicon declared with
      `rel` of `icon`, `shortcut icon`, `apple-touch-icon` or
      `apple-touch-icon-precomposed`; the PNG was declared `alternate icon`,
      which is not on that list, so the only thing Google was offered was an
      SVG. And the PNG it would have taken was 32x32, where Google asks for a
      square that is a multiple of 48 because it resizes to 48. Both were
      quietly wrong and the result was no brand icon in the SERP at all.

      The SVG stays first for browsers, which prefer it and render it at any
      size. 192 is 48x4.
    -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={BRAND_RED} />

    <!--
      The one font the first paint needs. Preloading the mono face too would
      compete with it for bandwidth during LCP, and the mono is below the fold
      on every page that has records to show.
    -->
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <a class="md-skip" href="#main">Skip to content</a>
    <ClinicStatusBar />
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
