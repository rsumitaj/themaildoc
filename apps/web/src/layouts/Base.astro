---
import '@maildoc/ui/maildoc.css';
import ClinicStatusBar from '../components/ClinicStatusBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Seo from '../components/Seo.astro';
import type { Props as SeoProps } from '../components/Seo.astro';

/**
 * Every page's shell. All SEO lives in `Seo.astro`, which this passes straight
 * through, so there is exactly one definition of a canonical, a card and a
 * schema block.
 */
type Props = SeoProps;

const seo = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...seo} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#E5322D" />

    <!--
      The one font the first paint needs. Preloading the mono face too would
      compete with it for bandwidth during LCP, and the mono is below the fold
      on every page that has records to show.
    -->
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <a class="md-skip" href="#main">Skip to content</a>
    <ClinicStatusBar />
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
