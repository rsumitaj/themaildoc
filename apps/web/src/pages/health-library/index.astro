---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ConsultLine from '../../components/ConsultLine.astro';

/**
 * The Health Library hub. Guides first, then everything filed under them, so
 * the pillar-to-cluster shape is visible to a reader and to a crawler without
 * either having to infer it.
 */
const entries = await getCollection('library', (entry) => !entry.data.draft);
const pillars = entries.filter((entry) => entry.data.kind === 'pillar');
const orphans = entries.filter(
  (entry) => entry.data.kind !== 'pillar' && !entry.data.pillar,
);

const clustersOf = (slug: string) => entries.filter((entry) => entry.data.pillar === slug);

/** Named here rather than linked to, so the section is worth its own space. */
const terms = (await getCollection('glossary', (entry) => !entry.data.draft)).sort((a, b) =>
  a.data.term.localeCompare(b.data.term),
);

const title = 'Health Library: email authentication guides | MailDoc';
const description =
  'Guides and answers on SPF, DKIM, DMARC and deliverability. Written from the RFCs, with the free test for each, and no signup to read any of it.';
---

<Base
  title={title}
  description={description}
  crumbs={[{ name: 'Health Library', href: '/health-library' }]}
>
  <section class="page">
    <div class="md-wrap">
      <p class="md-eyebrow" style="color: var(--md-red-ink)">Health Library</p>
      <h1>How email authentication actually works</h1>
      <p class="lead">
        Three guides and the articles that sit under them. Every one is written from the standards,
        cites the section it came from, and ends with the test that proves it on your own domain.
      </p>

      {
        pillars.map((pillar) => (
          <section class="cluster">
            <p class="md-eyebrow">Guide</p>
            <h2>
              <a href={`/health-library/${pillar.id}`}>{pillar.data.heading}</a>
            </h2>
            <p class="cluster__lead">{pillar.data.standfirst}</p>
            <p class="cluster__open">
              <a href={`/health-library/${pillar.id}`}>Read the guide &rarr;</a>
            </p>

            <div class="md-labgrid">
              {clustersOf(pillar.id).map((entry) => (
                <a class="md-labcard" href={`/health-library/${entry.id}`}>
                  <div class="md-labcard__top">
                    <h3>{entry.data.heading}</h3>
                  </div>
                  <p>{entry.data.standfirst}</p>
                </a>
              ))}
            </div>
          </section>
        ))
      }

      {
        orphans.length > 0 && (
          <section class="cluster">
            <h2>Everything else</h2>
            <div class="md-labgrid">
              {orphans.map((entry) => (
                <a class="md-labcard" href={`/health-library/${entry.id}`}>
                  <div class="md-labcard__top">
                    <h3>{entry.data.heading}</h3>
                  </div>
                  <p>{entry.data.standfirst}</p>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <section class="cluster">
        <p class="md-eyebrow">Glossary</p>
        <h2><a href="/glossary">Definitions</a></h2>
        <p class="cluster__lead">
          One page per term, for when you want the meaning rather than the guide.
        </p>
        <ul class="terms">
          {
            terms.map((term) => (
              <li>
                <a href={`/glossary/${term.id}`}>{term.data.term}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <ConsultLine />
    </div>
  </section>
</Base>

<style>
  .page {
    padding-block: var(--md-space-8) var(--md-space-9);
  }

  h1 {
    font-size: clamp(1.9rem, 4.6vw, 2.9rem);
    letter-spacing: var(--md-tracking-tight);
    margin-top: var(--md-space-2);
  }

  .lead {
    max-width: 46rem;
    margin-top: var(--md-space-4);
    font-size: 1.08rem;
    color: var(--md-muted);
    line-height: 1.6;
  }

  .cluster {
    margin-top: var(--md-space-8);
    padding-top: var(--md-space-6);
    border-top: var(--md-hairline) solid var(--md-line);
    max-width: 62rem;
  }

  .cluster h2 {
    font-size: 1.4rem;
    letter-spacing: var(--md-tracking-tight);
  }

  .cluster h2 a:hover {
    color: var(--md-red-ink);
  }

  .terms {
    display: flex;
    flex-wrap: wrap;
    gap: var(--md-space-2) var(--md-space-3);
    list-style: none;
    margin-top: var(--md-space-5);
  }

  .terms a {
    display: inline-block;
    font-family: var(--md-font-mono);
    font-size: var(--md-text-sm);
    color: var(--md-muted);
    border: var(--md-hairline) solid var(--md-line);
    border-radius: var(--md-radius-sm);
    padding: 0.3rem 0.7rem;
    transition: border-color var(--md-duration-fast) var(--md-ease);
  }

  .terms a:hover {
    border-color: var(--md-red-ink);
    color: var(--md-red-ink);
  }

  .cluster__open {
    margin-top: var(--md-space-3);
    font-size: var(--md-text-sm);
  }

  .cluster__open a {
    color: var(--md-red-ink);
    font-weight: var(--md-weight-medium);
  }

  .cluster__lead {
    margin-top: var(--md-space-3);
    color: var(--md-muted);
    line-height: 1.6;
  }

  /* Inside a sentence, so colour alone cannot mark it (WCAG 1.4.1). */
  .cluster__lead a {
    color: var(--md-red-ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

</style>
