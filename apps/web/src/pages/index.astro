---
import { getCollection } from 'astro:content';
import EkgBackground from '@maildoc/ui/EkgBackground.astro';
import Base from '../layouts/Base.astro';
import HomeCheckup from '../islands/HomeCheckup';
import SourcedStat from '../components/SourcedStat.astro';

/**
 * The three long guides, straight off the home page.
 *
 * They were reachable only through the footer, which is the weakest link on
 * any page. The home page is the one thing on this domain with authority to
 * lend, and lending it to the pages written to rank is the cheapest ranking
 * change available. It also answers the visitor who is not ready to type their
 * domain into a box yet, which is most of them.
 */
const guides = (await getCollection('library', (entry) => !entry.data.draft))
  .filter((entry) => entry.data.kind === 'pillar')
  .sort((a, b) => a.data.heading.localeCompare(b.data.heading));

/**
 * The brand leads here, and only here.
 *
 * Searching the brand name today returns results for a different site
 * entirely, because Google has no document anywhere that puts the word next
 * to what it means. The home page is the one that has to establish it; every
 * other page keeps the keyword first, where it belongs.
 */
const title = 'MailDoc: free email health check for SPF, DKIM and DMARC';
const description =
  "Free email checkup: enter your domain for a full diagnosis of SPF, DKIM, DMARC, MX and DNSSEC in seconds, with the exact fix for what is wrong.";

/**
 * The questions people actually type into a search box before they know what
 * SPF stands for. Answering them here earns the rich result and, more to the
 * point, means somebody arriving from that search finds their answer rather
 * than a tool they have to learn first.
 */
const faqs = [
  {
    q: 'How do I know if someone can send email pretending to be my domain?',
    a: 'Put your domain in the box above. The answer depends almost entirely on one record, DMARC, and on the policy it publishes. Without DMARC, or with a policy of p=none, anyone in the world can put your domain in the From line and most inboxes will deliver it. The checkup tells you which of those you are in one line, before any of the detail.',
  },
  {
    q: 'What is a good email authentication score?',
    a: 'Above 85 means nothing serious is wrong. Between 65 and 84 there are real gaps costing you delivery or leaving you exposed. Between 40 and 64 authentication is not doing its job. Below 40 is critical, and for most domains that score it is because anybody can send as them. The score is built from four separate questions rather than one list, so a domain can be excellent at stopping impersonation and still lose marks for reporting it cannot see. A record you have not published at all holds down the questions it would have answered, which is why a domain with nothing scores near zero rather than in the sixties.',
  },
  {
    q: 'Is this actually free, and do you store my domain?',
    a: 'It is free with no account, and there is no paid tier holding the real answer back. Every check reads public DNS, the same records any mail server reads when it decides what to do with your mail. Nothing about a checkup is stored. The only thing this site keeps is a consultation request, and only if you fill one in.',
  },
  {
    q: 'Why does another tool say my SPF is fine when this one does not?',
    a: 'Usually the lookup count. SPF allows ten DNS lookups and the ones inside your includes count against the same ten, so a record that looks short can be over the limit through somebody else’s vendor. Past ten, receivers return a permanent error and SPF fails for every message you send. This walks the whole chain and shows you the count with the tree that produced it.',
  },
  {
    q: 'What should I fix first?',
    a: 'Whatever the chart lists first. Findings are triaged by what they cost you, not by which record they sit in, so the first card is the one doing the most damage. Every card carries the exact record to publish and the standard it comes from.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Examine',
    body: 'We read your live DNS the way a receiving mail server does, every record, in the same order, with the same limits.',
  },
  {
    n: '02',
    title: 'Diagnose',
    body: 'Each record is graded against the RFCs and triaged: critical, urgent, needs attention, minor.',
  },
  {
    n: '03',
    title: 'Prescribe',
    body: 'Every condition comes with the exact fix, written to paste into your DNS. No jargon, no upsell.',
  },
  {
    n: '04',
    title: 'Treat',
    body: 'Do it yourself with the prescription, or hand it to someone who has run DMARC monitoring across 2,000+ domains.',
  },
];

const tests = [
  { name: 'SPF Test', href: '/lab/spf-checker', tag: 'RFC 7208', body: 'Full chain walk with the exact 10-lookup count. Catches the PermError other checkers miss.' },
  { name: 'DMARC Test', href: '/lab/dmarc-checker', tag: 'RFC 9989', body: 'Tree walk, inheritance, alignment and reporting. Is your policy actually being applied?' },
  { name: 'DKIM Test', href: '/lab/dkim-checker', tag: 'RFC 6376', body: 'Selector discovery and real key strength. Weak keys fail silently for years.' },
  { name: 'Spoofability', href: '/lab/spoofability', tag: 'the scary one', body: 'Can somebody send as you right now? One verdict, no hedging.' },
  { name: 'Sender Readiness', href: '/lab/sender-readiness', tag: 'Google, Yahoo, Microsoft', body: 'Will the bulk sender rules reject you? Find out before they do.' },
  { name: 'Bloodwork', href: '/bloodwork', tag: 'DMARC reports', body: 'Read your aggregate reports and see who is sending as you. Parsed in your browser.' },
];
---

<Base
  title={title}
  description={description}
  kind="website"
  faqs={faqs}
>
  <section class="hero">
    <EkgBackground />

    <div class="md-wrap">
      <SourcedStat />

      <h1>
        Is your domain <span class="sick">sick?</span><br class="linebreak" />
        Find out in 5 seconds.
      </h1>

      <p class="lead">
        The MailDoc runs a full checkup on your email, SPF, DKIM, DMARC, MX and DNSSEC, then hands
        you the exact prescription to fix what's wrong. Free, and no signup.
      </p>

      <HomeCheckup client:load />
    </div>
  </section>

  <section class="how">
    <div class="md-wrap">
      <h2 class="md-eyebrow">How the checkup works</h2>
      <div class="steps">
        {
          steps.map((step) => (
            <div class="step">
              <div class="step__n md-mono">{step.n}</div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="lab">
    <div class="md-wrap">
      <p class="md-eyebrow" style="color: var(--md-red-ink)">The Lab</p>
      <h2>Run a single test</h2>
      <p class="lab__lead">
        Need to check just one thing? The Lab has a dedicated test for every part of your email
        setup, and every one comes with a prescription.
      </p>

      <div class="labgrid">
        {
          tests.map((test) => (
            <a class="test" href={test.href}>
              <div class="test__head">
                <h3>{test.name}</h3>
                <span class="test__tag md-mono">{test.tag}</span>
              </div>
              <p>{test.body}</p>
            </a>
          ))
        }
      </div>
      <p class="lab__more"><a href="/lab">Every test in the Lab &rarr;</a></p>
    </div>
  </section>

  <section class="read">
    <div class="md-wrap">
      <p class="md-eyebrow" style="color: var(--md-red-ink)">Health Library</p>
      <h2>Understand it before you change it</h2>
      <p class="read__lead">
        Three guides that assume nothing, written to be read in order by somebody who has been told
        their email has a problem and given no more detail than that.
      </p>

      <div class="md-labgrid">
        {
          guides.map((guide) => (
            <a class="md-labcard" href={`/health-library/${guide.id}`}>
              <div class="md-labcard__top">
                <h3>{guide.data.heading}</h3>
                <span class="md-eyebrow">Guide</span>
              </div>
              <p>{guide.data.standfirst}</p>
            </a>
          ))
        }
      </div>

      <p class="read__more">
        Or look a term up in <a href="/glossary">the glossary</a>, or read what a finding means in{' '}
        <a href="/library/checks">the list of conditions</a>.
      </p>
    </div>
  </section>

  <section class="faq">
    <div class="md-wrap">
      <h2 class="md-eyebrow">Common questions</h2>
      {
        faqs.map((faq) => (
          <details class="faq__item">
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--md-space-12) var(--md-space-16);
  }

  /* Everything in the hero sits above the trace, in its own stacking context. */
  .hero > .md-wrap {
    position: relative;
    z-index: 1;
  }

  h1 {
    font-size: var(--md-text-hero);
    line-height: var(--md-leading-tight);
    letter-spacing: var(--md-tracking-hero);
    text-wrap: balance;
  }

  @media (max-width: 620px) {
    .linebreak {
      display: none;
    }

    h1 {
      text-wrap: normal;
    }
  }

  .sick {
    color: var(--md-red-ink);
  }

  .lead {
    margin-top: var(--md-space-5);
    /* 65–75 characters. Past that a reader loses the start of the next line. */
    max-width: 62ch;
    font-size: var(--md-text-lg);
    color: var(--md-muted);
  }

  .how {
    border-top: var(--md-hairline) solid var(--md-line);
    padding-block: var(--md-space-12);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--md-space-6);
    margin-top: var(--md-space-6);
  }

  @media (max-width: 760px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .step__n {
    color: var(--md-red-ink);
    font-weight: var(--md-weight-bold);
    font-size: var(--md-text-sm);
  }

  .step h3 {
    font-size: var(--md-text-md);
    margin: var(--md-space-2) 0 var(--md-space-1);
  }

  .step p {
    color: var(--md-muted);
    font-size: var(--md-text-sm);
    line-height: var(--md-leading-body);
  }

  .lab {
    border-top: var(--md-hairline) solid var(--md-line);
    background: var(--md-card);
    padding-block: var(--md-space-12);
  }

  .lab h2 {
    font-size: var(--md-text-2xl);
    margin-top: var(--md-space-3);
  }

  .lab__lead {
    color: var(--md-muted);
    max-width: 62ch;
    margin-top: var(--md-space-3);
  }

  .labgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--md-space-3);
    margin-top: var(--md-space-8);
  }

  @media (max-width: 860px) {
    .labgrid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .labgrid {
      grid-template-columns: 1fr;
    }
  }

  .test {
    border: var(--md-hairline) solid var(--md-line);
    border-radius: var(--md-radius-md);
    padding: var(--md-space-4) var(--md-space-5);
    background: var(--md-bg);
    transition:
      border-color var(--md-duration-fast) var(--md-ease),
      transform var(--md-duration-fast) var(--md-ease);
  }

  .test__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--md-space-3);
  }

  .test h3 {
    font-size: var(--md-text-15);
  }

  .test__tag {
    font-size: var(--md-text-10);
    color: var(--md-faint);
    white-space: nowrap;
  }

  .test p {
    color: var(--md-muted);
    font-size: var(--md-text-sm);
    margin-top: var(--md-space-1);
    line-height: var(--md-leading-body);
  }

  .lab__more {
    margin-top: var(--md-space-5);
    font-size: var(--md-text-sm);
  }

  .lab__more a {
    color: var(--md-red-ink);
  }

  @media (hover: hover) {
    .test:hover {
      border-color: var(--md-red-ink);
      transform: translateY(-2px);
    }
  }

  .read {
    border-top: var(--md-hairline) solid var(--md-line);
    padding-block: var(--md-space-12);
  }

  .read h2 {
    font-size: var(--md-text-2xl);
    margin-top: var(--md-space-3);
  }

  .read__lead {
    color: var(--md-muted);
    max-width: 62ch;
    margin: var(--md-space-3) 0 var(--md-space-8);
  }

  .read__more {
    margin-top: var(--md-space-6);
    font-size: var(--md-text-sm);
    color: var(--md-muted);
  }

  .read__more a {
    color: var(--md-red-ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .faq {
    padding-block: var(--md-space-12);
    border-top: var(--md-hairline) solid var(--md-line);
  }

  .faq__item {
    border-bottom: var(--md-hairline) solid var(--md-line-soft);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--md-space-4);
    min-height: var(--md-tap);
    padding: var(--md-space-4) 0;
    font-weight: var(--md-weight-medium);
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    content: '+';
    font-family: var(--md-font-mono);
    color: var(--md-red-ink);
  }

  .faq__item[open] summary::after {
    content: '\2212';
  }

  .faq__item p {
    padding-bottom: var(--md-space-4);
    color: var(--md-muted);
    max-width: 68ch;
    line-height: var(--md-leading-prose);
  }
</style>
