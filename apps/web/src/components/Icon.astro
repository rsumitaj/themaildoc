---
/**
 * Custom medical line icons. Emoji are banned in production — every glyph on
 * the page is one of these.
 */
type IconName = 'pulse' | 'stethoscope' | 'arrow-right';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'pulse' && <path d="M2 12h5l2-5 3 10 2.5-5H22" />}
  {
    name === 'stethoscope' && (
      <>
        <path d="M5 3v6a4 4 0 0 0 8 0V3" />
        <path d="M3 3h3M12 3h3" />
        <path d="M9 13v3a5 5 0 0 0 10 0v-1" />
        <circle cx="19" cy="12" r="2.5" />
      </>
    )
  }
  {name === 'arrow-right' && <path d="M4 12h15M13 6l6 6-6 6" />}
</svg>
