---
/**
 * The MailDoc mark: a pulse line through an envelope.
 * Never the Red Cross emblem — that is legally protected (Geneva Conventions,
 * 18 U.S.C. §706).
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 34, class: className } = Astro.props;
---

<svg
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class={className}
  role="img"
  aria-label="The MailDoc"
  fill="none"
>
  <rect x="14" y="26" width="72" height="50" rx="7" stroke="currentColor" stroke-width="7" />
  <path d="M14 31 L50 56 L86 31" stroke="currentColor" stroke-width="7" stroke-linejoin="round" />
  <path
    d="M19 64 H39 L44 64 L50 49 L57 79 L62 64 H81"
    stroke="currentColor"
    stroke-width="7"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
